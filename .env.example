# --- BASIC APPLICATION SETTINGS ---
ENV=dev
LOG_LEVEL=INFO
# Read from Key Vault at startup, not from this file.
SECRET_KEY=

# --- DATABASE (Postgres inside AKS cluster via Helm chart) ---
DATABASE_URL=postgresql+asyncpg://ragadmin:changeme@localhost:5432/rag_db

# --- CACHE (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- VECTOR DB (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_collection

# --- GRAPH DB (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- AZURE (Infrastructure) ---
AZURE_REGION=swedencentral
# User-assigned managed identity: azure issues, rotates short-lived tokens
AZURE_CLIENT_ID=
AZURE_KEY_VAULT_NAME=
# Blob storage (account: namespace, globally unique, container: the bucket inside it)
AZURE_STORAGE_ACCOUNT=ragplatformdocs
AZURE_STORAGE_CONTAINER=documents

# --- RAY CLUSTER (AI Engines) ---
# In K8s, these point to internal Service DNS
# Locally, you might port-forward
RAY_LLM_ENDPOINT=http://localhost:8000/llm
RAY_EMBED_ENDPOINT=http://localhost:8000/embed

# --- OBSERVABILITY ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317